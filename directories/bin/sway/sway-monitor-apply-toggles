#!/usr/bin/env bash
# Maintained in https://github.com/rileyrg/linux-init
prefix=${1:-"\$mod+control"};
displays=$(sway-monitor-ids)
count=1;
while IFS= read -r displayID ; do
    bindString="bindsym ${prefix}+${count} output ${displayID} power toggle"
    swaymsg "${bindString}" 
    ((count++))
done <<< "$displays"
