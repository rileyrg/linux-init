#!/usr/bin/env bash
# Maintained in https://github.com/rileyrg/linux-init
if ! network-online; then
    echo "offline"
    exit 1
fi
if pgrep -x "rclone" > /dev/null; then
    echo "syncrclone already running"
    exit 1
else
    if [[ -z $SYNC_CRON ]]; then
        syncrclone | mail -s "syncrclone manual : $(date)" $USER
    else
        syncrclone
    fi
    exit 0
fi
